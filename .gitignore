# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Tina generates these on dev and build
tina/__generated__
public/admin

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw Drive exports (40MB). Optimized versions live in public/images.
# Regenerate with: node scripts/prep-images.mjs
assets/
_archive/
scripts/team-sheet.png

# Source PDFs stay local. The ICP is marked Internal Use Only and carries
# internal pricing; neither is needed to build the site.
_brand/

# Raw video exports are large; transcoded loops live in public/video

.vercel
.env*
!.env.example
scratch/

# Local session notes
CLAUDE.md
REVIEW.md
.claude/settings.json
